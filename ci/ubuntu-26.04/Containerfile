# Reference build environment for the Dovecot 2.4.2 baseline (issue #354).
FROM docker.io/library/ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN echo "postfix postfix/main_mailer_type select No configuration" \
      | debconf-set-selections \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      capnproto \
      dovecot-dev \
      dovecot-imapd \
      git \
      libcapnp-dev \
      libglib2.0-dev \
      meson \
      ninja-build \
      pkg-config \
      postfix \
      python3 \
      unzip \
    && rm -rf /var/lib/apt/lists/*
